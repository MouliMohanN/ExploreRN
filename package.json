{
  "name": "ExploreRN",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start -- --reset-cache",
    "test": "jest",
    "ts:check": "tsc -p . --noEmit",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "build:release:android": "cd android && ./gradlew assembleRelease cd ..",
    "build:release:ios": "cd ios && pod install && cd .. && xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/AwesomeProject.xcworkspace -UseNewBuildSystem=YES -scheme AwesomeProject -configuration Release -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "detox:test:android": "detox test --config-path .detoxrc-ci.js --configuration android.emu.release --cleanup",
    "detox:test:ios": "detox test --config-path .detoxrc-ci.js --configuration ios.sim.release --cleanup",
    "fingerprint:android": "npx expo-updates fingerprint:generate --platform android | jq -r '.hash' | xargs -n 1 echo 'fingerprint:'",
    "fingerprint:ios": "npx expo-updates fingerprint:generate --platform ios | jq -r '.hash' | xargs -n 1 echo 'fingerprint:'",
    "build:debug:android": "cd android && ./gradlew assembleDebug",
    "fast-build": "ts-node scripts/useCase/fastDebugBuild/debugBuildSingleAbi.ts",
    "build:debug:ios": "cd ios && pod install && cd .. && xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/AwesomeProject.xcworkspace -UseNewBuildSystem=YES -scheme AwesomeProject -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "maestro:test": "maestro test --debug-output maestro-debug-output .maestro",
    "adb-install": "adb install android/app/build/outputs/apk/debug/app-debug.apk && adb reverse tcp:8081 tcp:8081 && npm run start",
    "adb-open-app": "adb shell am start -n com.explorern/com.explorern.MainActivity -a android.intent.action.MAIN -c android.intent.category.LAUNCHER",
    "adb-close-app": "adb shell am force-stop com.explorern",
    "adb-shell-top": "adb shell top -m 50",
    "adb-shell-recents": "adb shell dumpsys activity recents",
    "adb-shell-remove-stack": "adb shell am stack remove 170",
    "adb-connect": "adb reverse tcp:8081 tcp:8081",
    "adb-connect-dev-tools": "adb reverse tcp:8097 tcp:8097",
    "adb-uninstall": "adb uninstall com.explorern",
    "install-abi-apk": "ts-node scripts/useCase/fastDebugBuild/debugInstallAbi.ts",
    "clean-install-android": "rm -rf node_modules && rm -rf package-lock.json && npm install -f && npm run fast-build",
    "clean-install-android-release": "cd android && ./gradlew installRelease && cd ..",
    "android-release": "cd android && ./gradlew installRelease && cd ..",
    "clean-gradle": "cd android && ./gradlew clean && cd ..",
    "gradle-tasks": "cd android && ./gradlew tasks && cd ..",
    "generate-spec": "cd android && ./gradlew generateCodegenArtifactsFromSchema && cd ..",
    "rn-info": "npx react-native-info",
    "move-mouse-robotjs": "ts-node scripts/useCase/moveMouse/robotjs.ts",
    "move-mouse-nutjs": "ts-node scripts/useCase/moveMouse/nutjs.ts",
    "screens:generate": "node scripts/navigation/screenScanner.js",
    "screens:watch": "node scripts/navigation/screenScanner.js --watch",
    "create-screen": "node scripts/navigation/createScreen.js inputText InputText && npm run screens:generate",
    "prestart": "npm run screens:generate"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.4.2",
    "@react-navigation/elements": "2.5.2",
    "@react-navigation/material-top-tabs": "7.3.2",
    "@react-navigation/native": "7.1.14",
    "@react-navigation/native-stack": "7.3.21",
    "react": "19.1.0",
    "react-native": "0.80.1",
    "react-native-fs": "2.20.0",
    "react-native-gesture-handler": "2.27.2",
    "react-native-pager-view": "6.8.1",
    "react-native-paper": "5.14.5",
    "react-native-reanimated": "4.1.0",
    "react-native-safe-area-context": "5.5.2",
    "react-native-screens": "4.13.1",
    "react-native-share": "12.1.0",
    "react-native-vector-icons": "10.3.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "1.6.2",
    "reanimated-tab-view": "0.4.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-env": "7.28.0",
    "@babel/runtime": "7.27.6",
    "@nut-tree-fork/nut-js": "4.2.6",
    "@react-native-community/cli": "19.1.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.80.1",
    "@react-native/eslint-config": "0.80.1",
    "@react-native/metro-config": "0.80.1",
    "@react-native/typescript-config": "0.80.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.1.0",
    "@types/react": "19.1.8",
    "@types/react-native-vector-icons": "6.4.18",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "chokidar": "^4.0.1",
    "eslint": "9.31.0",
    "jest": "30.0.5",
    "metro-react-native-babel-transformer": "^0.77.0",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "4.2.0",
    "react-native-bundle-visualizer": "^3.1.3",
    "react-test-renderer": "19.1.0",
    "robotjs": "0.6.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
  },
  "engines": {
    "node": ">=18"
  }
}
